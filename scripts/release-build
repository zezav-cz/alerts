#!/usr/bin/env bash
# Build the release binaries for one version into dist/, plus SHA256SUMS.
# Usage: scripts/release-build vX.Y.Z
set -euo pipefail

version=${1:?usage: scripts/release-build vX.Y.Z}
if [[ ! $version =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "version must look like v1.2.3, got $version" >&2
  exit 1
fi

rm -rf dist
mkdir dist
for arch in amd64 arm64; do
  CGO_ENABLED=0 GOOS=linux GOARCH=$arch go build -trimpath \
    -ldflags "-s -w -X main.version=$version" \
    -o "dist/alerts_linux_$arch" ./cmd/alerts
done
(cd dist && sha256sum alerts_linux_* > SHA256SUMS)
